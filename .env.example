# Copy to .env for local docker compose use.

GROCERY_DB_PASSWORD=change-me

# Same LAN address you use to open paperless-ngx in a browser
PAPERLESS_BASE_URL=http://your-paperless-host:8010
PAPERLESS_PUBLIC_URL=http://your-paperless-host:8010
# Same token you use for paperless-gpt
PAPERLESS_API_TOKEN=your_paperless_api_token

OPENAI_API_KEY=your_openai_api_key

RECEIPT_TRIGGER_TAGS=receipts,Grocery
