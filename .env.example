# Copy to .env for local docker compose use. When deploying via Portainer's
# git-based stack feature, don't commit a real .env - enter these as the
# stack's "Environment variables" in the Portainer UI instead, so secrets
# never touch the repo.

GROCERY_DB_PASSWORD=change-me

# Same LAN address you use to open paperless-ngx in a browser (e.g. http://truenas.local:8010)
PAPERLESS_BASE_URL=http://your-paperless-host:8010
PAPERLESS_PUBLIC_URL=http://your-paperless-host:8010
# Same token you use for paperless-gpt
PAPERLESS_API_TOKEN=your_paperless_api_token

OPENAI_API_KEY=your_openai_api_key

RECEIPT_TRIGGER_TAGS=receipts,Grocery
